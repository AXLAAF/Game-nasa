[ext_resource type="Script" path="res://game/data/body_def.gd" id="1_jupiter"]

[resource]
script = ExtResource("1_jupiter")
id = &"jupiter"
display_name = "Júpiter"
description = "Gigante a 5,2 UA [NASA]. No tiene suelo: Galileo se hundió en su atmósfera en 2003 para no contaminar Europa. Los cinturones de radiación queman la electrónica."
color = Color(0.82, 0.7, 0.52, 1)
atmo_color = Color(0.9, 0.75, 0.5, 0.35)
parent_id = &"sol"
orbit_radius = 10408.0
orbit_phase = 1.2
radius = 52.0
mu = 180000.0
surface_gravity = 24.79
atmosphere = 2.0
landable = false
hazards = Array[StringName]([&"radiation"])
