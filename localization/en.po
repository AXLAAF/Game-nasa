msgid ""
msgstr ""
"Language: en\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Project-Id-Version: Contratista Orbital\n"

#: content/bodies/jupiter.tres:8
msgid "Júpiter"
msgstr "Jupiter"

#: content/bodies/jupiter.tres:9
msgid "Gigante a 5,2 UA [NASA]. No tiene suelo: Galileo se hundió en su atmósfera en 2003 para no contaminar Europa. Los cinturones de radiación queman la electrónica."
msgstr "Giant at 5.2 AU [NASA]. It has no surface: Galileo sank into its atmosphere in 2003 to avoid contaminating Europa. The radiation belts fry electronics."

#: content/bodies/luna.tres:8
msgid "Luna"
msgstr "Moon"

#: content/bodies/luna.tres:9
msgid "A unos 384 000 km de la Tierra [NASA]. Sin aire: hay que bajar a motor. Ahí siguen las etapas de descenso Apolo y los vehículos lunares."
msgstr "About 384,000 km from Earth [NASA]. No air: you have to land on engines. The Apollo descent stages and the lunar rovers are still there."

#: content/bodies/marte.tres:8
msgid "Marte"
msgstr "Mars"

#: content/bodies/marte.tres:9
msgid "A 1,52 UA [NASA]. El aire real es muy fino; en el juego alcanza para un paracaídas. El polvo tapa los paneles de las sondas que se quedaron."
msgstr "At 1.52 AU [NASA]. The real air is very thin; in the game it is enough for a parachute. Dust covers the panels of the probes left behind."

#: content/bodies/mercurio.tres:8
msgid "Mercurio"
msgstr "Mercury"

#: content/bodies/mercurio.tres:9
msgid "El más cercano al Sol: 0,39 UA [NASA]. Sin aire y con el día abrasador. MESSENGER chocó aquí en 2015."
msgstr "Closest to the Sun: 0.39 AU [NASA]. No air and a scorching day. MESSENGER crashed here in 2015."

#: content/bodies/neptuno.tres:8
msgid "Neptuno"
msgstr "Neptune"

#: content/bodies/neptuno.tres:9
msgid "El más lejano, a 30,1 UA [NASA]. Oscuro, frío y sin superficie firme."
msgstr "The farthest, at 30.1 AU [NASA]. Dark, cold and with no solid surface."

#: content/bodies/saturno.tres:8
msgid "Saturno"
msgstr "Saturn"

#: content/bodies/saturno.tres:9
msgid "Gigante con anillos, a 9,6 UA [NASA]. Cassini se destruyó en su atmósfera en 2017. El suelo útil está en Titán."
msgstr "Ringed giant, at 9.6 AU [NASA]. Cassini was destroyed in its atmosphere in 2017. The usable ground is on Titan."

#: content/bodies/sol.tres:8
msgid "Sol"
msgstr "Sun"

#: content/bodies/sol.tres:9
msgid "El Sol. No se aterriza."
msgstr "The Sun. You do not land here."

#: content/bodies/tierra.tres:8
msgid "Tierra"
msgstr "Earth"

#: content/bodies/tierra.tres:9
msgid "Casa. Órbita a 1 UA [NASA]. El radio y la gravedad del mapa están a escala de juego."
msgstr "Home. Orbit at 1 AU [NASA]. The radius and gravity on the map are at game scale."

#: content/bodies/titan.tres:8
msgid "Titán"
msgstr "Titan"

#: content/bodies/titan.tres:9
msgid "Luna de Saturno con aire y frío. Huygens, llevado por el Cassini de la NASA, se posó aquí el 14 de enero de 2005."
msgstr "A moon of Saturn with air and cold. Huygens, carried by NASA's Cassini, landed here on January 14, 2005."

#: content/bodies/urano.tres:8
msgid "Urano"
msgstr "Uranus"

#: content/bodies/urano.tres:9
msgid "Gigante de hielo a 19,2 UA [NASA]. El Sol calienta poco y no hay suelo donde posarse."
msgstr "Ice giant at 19.2 AU [NASA]. The Sun gives little heat and there is no ground to land on."

#: content/bodies/venus.tres:8
msgid "Venus"
msgstr "Venus"

#: content/bodies/venus.tres:9
msgid "A 0,72 UA [NASA]. El aire real es unas 90 veces más denso que el de la Tierra; aquí está suavizado para que un escudo y un paracaídas puedan bajar."
msgstr "At 0.72 AU [NASA]. The real air is about 90 times denser than Earth's; here it is softened so a shield and a parachute can get down."

#: content/encounters/asteroide_hielo.tres:8
msgid "Perforar"
msgstr "Drill"

#: content/encounters/asteroide_hielo.tres:17
msgid "Tanques un poco más llenos."
msgstr "Tanks a little fuller."

#: content/encounters/asteroide_hielo.tres:18
msgid "El taladro rebotó contra la nave."
msgstr "The drill bounced off the ship."

#: content/encounters/asteroide_hielo.tres:23
msgid "Escanear al pasar"
msgstr "Scan on the way past"

#: content/encounters/asteroide_hielo.tres:35
msgid "Asteroide de hielo"
msgstr "Ice asteroid"

#: content/encounters/asteroide_hielo.tres:36
msgid "Una roca cubierta de hielo sucio. Hielo = combustible, si sabes perforar."
msgstr "A rock covered in dirty ice. Ice = fuel, if you know how to drill."

#: content/encounters/asteroide_metal.tres:8
msgid "Minar"
msgstr "Mine"

#: content/encounters/asteroide_metal.tres:16
msgid "Bodega llena de metal."
msgstr "Cargo bay full of metal."

#: content/encounters/asteroide_metal.tres:17
msgid "Un fragmento golpeó la nave."
msgstr "A fragment hit the ship."

#: content/encounters/asteroide_metal.tres:22
msgid "Aterrizaje relámpago"
msgstr "Lightning landing"

#: content/encounters/asteroide_metal.tres:32
msgid "Muestras y una caja rara."
msgstr "Samples and a rare crate."

#: content/encounters/asteroide_metal.tres:33
msgid "Rebotaste contra la roca."
msgstr "You bounced off the rock."

#: content/encounters/asteroide_metal.tres:42
msgid "Asteroide metálico"
msgstr "Metal asteroid"

#: content/encounters/asteroide_metal.tres:43
msgid "Hierro y níquel puro. Vale una fortuna... si no te parte el casco."
msgstr "Pure iron and nickel. Worth a fortune... if it doesn't crack your hull."

#: content/encounters/baliza_dorada.tres:8
msgid "Todo o nada"
msgstr "All or nothing"

#: content/encounters/baliza_dorada.tres:17
msgid "Premio mayor."
msgstr "Jackpot."

#: content/encounters/baliza_dorada.tres:18
msgid "La baliza era una mina."
msgstr "The beacon was a mine."

#: content/encounters/baliza_dorada.tres:22
msgid "Tomar lo seguro"
msgstr "Take the safe option"

#: content/encounters/baliza_dorada.tres:30
msgid "Baliza dorada"
msgstr "Golden beacon"

#: content/encounters/baliza_dorada.tres:31
msgid "Una baliza brilla en dorado. Nadie sabe quién la puso. Todo o nada."
msgstr "A beacon glows gold. Nobody knows who put it there. All or nothing."

#: content/encounters/cache_pirata.tres:8
msgid "Forzar la esclusa"
msgstr "Force the airlock"

#: content/encounters/cache_pirata.tres:18
msgid "Caja fuerte: créditos y un kit."
msgstr "Safe: credits and a kit."

#: content/encounters/cache_pirata.tres:19
msgid "Una trampa de gas cortó los circuitos."
msgstr "A gas trap cut the circuits."

#: content/encounters/cache_pirata.tres:23
msgid "Remolcar el casco"
msgstr "Tow the hull"

#: content/encounters/cache_pirata.tres:32
msgid "Arrancaste un módulo útil."
msgstr "You tore off a useful module."

#: content/encounters/cache_pirata.tres:33
msgid "El casco se deshizo al remolcar."
msgstr "The hull fell apart while towing."

#: content/encounters/cache_pirata.tres:37
msgid "Dejarlo"
msgstr "Leave it"

#: content/encounters/cache_pirata.tres:42
msgid "Caché pirata"
msgstr "Pirate cache"

#: content/encounters/cache_pirata.tres:43
msgid "Una nave sin marcas flota a la deriva. Alguien escondió botín aquí."
msgstr "An unmarked ship drifts here. Someone hid loot aboard."

#: content/encounters/campo_escombros.tres:8
msgid "Atravesar lento"
msgstr "Cross slowly"

#: content/encounters/campo_escombros.tres:18
msgid "Pasaste limpio y recogiste restos."
msgstr "You passed through clean and picked up scrap."

#: content/encounters/campo_escombros.tres:19
msgid "Un fragmento te abrió un panel."
msgstr "A fragment tore open a panel."

#: content/encounters/campo_escombros.tres:23
msgid "Empujar a toda"
msgstr "Push through at full thrust"

#: content/encounters/campo_escombros.tres:32
msgid "Saliste con chatarra valiosa."
msgstr "You came out with valuable scrap."

#: content/encounters/campo_escombros.tres:33
msgid "El campo te rajó un tanque."
msgstr "The field split a tank."

#: content/encounters/campo_escombros.tres:37
msgid "Rodear"
msgstr "Go around"

#: content/encounters/campo_escombros.tres:42
msgid "Campo de escombros"
msgstr "Debris field"

#: content/encounters/campo_escombros.tres:43
msgid "Restos de una estación vieja giran a cientos de metros por segundo."
msgstr "Wreckage of an old station spins at hundreds of meters per second."

#: content/encounters/cola_cometa.tres:8 content/encounters/cometa_cristal.tres:8
msgid "Recoger hielo"
msgstr "Collect ice"

#: content/encounters/cola_cometa.tres:18
msgid "Tanques cargados."
msgstr "Tanks loaded."

#: content/encounters/cola_cometa.tres:19
msgid "Granizo contra el casco."
msgstr "Hail against the hull."

#: content/encounters/cola_cometa.tres:23 content/encounters/cometa_raro.tres:23
msgid "Fotografiar"
msgstr "Photograph"

#: content/encounters/cola_cometa.tres:31
msgid "Cola de cometa"
msgstr "Comet tail"

#: content/encounters/cola_cometa.tres:32
msgid "Hielo y polvo brillante. Combustible gratis y peligro gratis."
msgstr "Ice and glittering dust. Free fuel and free danger."

#: content/encounters/cometa_cristal.tres:18
msgid "Propelente gratis y muestras."
msgstr "Free propellant and samples."

#: content/encounters/cometa_cristal.tres:19
msgid "El frío agarrotó las líneas."
msgstr "The cold seized up the lines."

#: content/encounters/cometa_cristal.tres:23
msgid "Vender coordenadas"
msgstr "Sell coordinates"

#: content/encounters/cometa_cristal.tres:28
msgid "La agencia pagó por la ruta."
msgstr "The agency paid for the route."

#: content/encounters/cometa_cristal.tres:32 content/encounters/senal_debil.tres:21
msgid "Ignorar"
msgstr "Ignore"

#: content/encounters/cometa_cristal.tres:37
msgid "Cometa de cristal"
msgstr "Crystal comet"

#: content/encounters/cometa_cristal.tres:38
msgid "Un núcleo brillante arrastra una cola de hielo puro."
msgstr "A bright nucleus trails a tail of pure ice."

#: content/encounters/cometa_raro.tres:8
msgid "Tomar muestra del núcleo"
msgstr "Take a sample of the nucleus"

#: content/encounters/cometa_raro.tres:18
msgid "Ciencia de primera."
msgstr "First-rate science."

#: content/encounters/cometa_raro.tres:19
msgid "Un chorro de gas te golpeó."
msgstr "A jet of gas hit you."

#: content/encounters/cometa_raro.tres:31
msgid "Núcleo de cometa"
msgstr "Comet nucleus"

#: content/encounters/cometa_raro.tres:32
msgid "Puedes ver el núcleo: compuestos orgánicos rarísimos."
msgstr "You can see the nucleus: extremely rare organic compounds."

#: content/encounters/eco_extrano.tres:8
msgid "Seguir la señal"
msgstr "Follow the signal"

#: content/encounters/eco_extrano.tres:17
msgid "Cajas flotando en la nada."
msgstr "Crates floating in the void."

#: content/encounters/eco_extrano.tres:18
msgid "Interferencia que frie circuitos."
msgstr "Interference that fries circuits."

#: content/encounters/eco_extrano.tres:22
msgid "Grabar y seguir"
msgstr "Record and move on"

#: content/encounters/eco_extrano.tres:30
msgid "Eco extrano"
msgstr "Strange echo"

#: content/encounters/eco_extrano.tres:31
msgid "La señal se repite con un patrón que no es natural."
msgstr "The signal repeats in a pattern that is not natural."

#: content/encounters/enjambre.tres:8
msgid "Atravesarlo"
msgstr "Cross it"

#: content/encounters/enjambre.tres:17
msgid "Saliste del otro lado."
msgstr "You came out the other side."

#: content/encounters/enjambre.tres:18
msgid "El casco quedó como colador."
msgstr "The hull came out like a sieve."

#: content/encounters/enjambre.tres:23
msgid "Rodearlo"
msgstr "Go around it"

#: content/encounters/enjambre.tres:27
msgid "Rodeo seguro."
msgstr "Safe detour."

#: content/encounters/enjambre.tres:32
msgid "Enjambre de rocas"
msgstr "Rock swarm"

#: content/encounters/enjambre.tres:33
msgid "Un cúmulo de escombros en tu ruta. Dentro hay cristales."
msgstr "A cluster of debris on your route. There are crystals inside."

#: content/encounters/estacion_fantasma.tres:8
msgid "Abordar a lo loco"
msgstr "Board recklessly"

#: content/encounters/estacion_fantasma.tres:19
msgid "Botín completo."
msgstr "Full loot."

#: content/encounters/estacion_fantasma.tres:20
msgid "Algo explotó dentro."
msgstr "Something exploded inside."

#: content/encounters/estacion_fantasma.tres:24
msgid "Acoplar con cuidado"
msgstr "Dock carefully"

#: content/encounters/estacion_fantasma.tres:33
msgid "Combustible y un kit."
msgstr "Fuel and a kit."

#: content/encounters/estacion_fantasma.tres:34
msgid "Mal acople."
msgstr "Bad docking."

#: content/encounters/estacion_fantasma.tres:44
msgid "Estación fantasma"
msgstr "Ghost station"

#: content/encounters/estacion_fantasma.tres:45
msgid "Una estación apagada gira lentamente. Las luces de emergencia parpadean."
msgstr "A dark station turns slowly. The emergency lights flicker."

#: content/encounters/faro_antiguo.tres:8
msgid "Descifrar la señal"
msgstr "Decode the signal"

#: content/encounters/faro_antiguo.tres:19
msgid "Mapas olvidados y dos cajas selladas."
msgstr "Forgotten maps and two sealed crates."

#: content/encounters/faro_antiguo.tres:20
msgid "El protocolo te dejó ciego un rato."
msgstr "The protocol left you blind for a while."

#: content/encounters/faro_antiguo.tres:24
msgid "Retransmitir a la agencia"
msgstr "Relay to the agency"

#: content/encounters/faro_antiguo.tres:33
msgid "Pagaron por el enlace."
msgstr "They paid for the link."

#: content/encounters/faro_antiguo.tres:34
msgid "Se cortó a mitad."
msgstr "It cut out halfway."

#: content/encounters/faro_antiguo.tres:38
msgid "Apagar receptores"
msgstr "Shut off receivers"

#: content/encounters/faro_antiguo.tres:43
msgid "Faro antiguo"
msgstr "Ancient lighthouse"

#: content/encounters/faro_antiguo.tres:44
msgid "Una baliza late con un código que nadie ha oído en décadas."
msgstr "A beacon pulses with a code nobody has heard in decades."

#: content/encounters/nave_rival.tres:8
msgid "Acoplar"
msgstr "Dock"

#: content/encounters/nave_rival.tres:19
msgid "Jackpot de chatarra."
msgstr "Scrap jackpot."

#: content/encounters/nave_rival.tres:20
msgid "Choque feo."
msgstr "Ugly crash."

#: content/encounters/nave_rival.tres:25
msgid "Hackear su computadora"
msgstr "Hack its computer"

#: content/encounters/nave_rival.tres:34
msgid "Transferencia completa."
msgstr "Transfer complete."

#: content/encounters/nave_rival.tres:35
msgid "Virus en tu sistema."
msgstr "Virus in your system."

#: content/encounters/nave_rival.tres:44
msgid "Nave de otra agencia"
msgstr "Another agency's ship"

#: content/encounters/nave_rival.tres:45
msgid "Una nave rival a la deriva. Su bodega está llena."
msgstr "A rival ship adrift. Its cargo bay is full."

#: content/encounters/nube_ionica.tres:8
msgid "Cargar baterías"
msgstr "Charge batteries"

#: content/encounters/nube_ionica.tres:18
msgid "La nube te cargó las celdas."
msgstr "The cloud charged your cells."

#: content/encounters/nube_ionica.tres:19
msgid "Una descarga frió la electrónica."
msgstr "A discharge fried the electronics."

#: content/encounters/nube_ionica.tres:23
msgid "Tomar lecturas"
msgstr "Take readings"

#: content/encounters/nube_ionica.tres:32
msgid "Datos limpios para la agencia."
msgstr "Clean data for the agency."

#: content/encounters/nube_ionica.tres:33
msgid "El sensor se saturó."
msgstr "The sensor saturated."

#: content/encounters/nube_ionica.tres:37
msgid "Esquivar"
msgstr "Dodge"

#: content/encounters/nube_ionica.tres:42
msgid "Nube iónica"
msgstr "Ion cloud"

#: content/encounters/nube_ionica.tres:43
msgid "Una mancha brillante de plasma se mueve sola. Carga y quema por igual."
msgstr "A bright patch of plasma moves on its own. It charges and burns alike."

#: content/encounters/senal_debil.tres:8
msgid "Investigar"
msgstr "Investigate"

#: content/encounters/senal_debil.tres:16
msgid "Un satélite con datos vendibles."
msgstr "A satellite with sellable data."

#: content/encounters/senal_debil.tres:17
msgid "Era una trampa de interferencia."
msgstr "It was an interference trap."

#: content/encounters/senal_debil.tres:26
msgid "Señal débil"
msgstr "Weak signal"

#: content/encounters/senal_debil.tres:27
msgid "Un pitido en frecuencia de emergencia."
msgstr "A beep on the emergency frequency."

#: content/encounters/sobrevuelo_lunar.tres:8
msgid "Pasada rasante"
msgstr "Low pass"

#: content/encounters/sobrevuelo_lunar.tres:18
msgid "Fotos espectaculares."
msgstr "Spectacular photos."

#: content/encounters/sobrevuelo_lunar.tres:19
msgid "Rozaste un pico."
msgstr "You grazed a peak."

#: content/encounters/sobrevuelo_lunar.tres:23
msgid "Escanear cráteres"
msgstr "Scan craters"

#: content/encounters/sobrevuelo_lunar.tres:38
msgid "Sobrevuelo"
msgstr "Flyby"

#: content/encounters/sobrevuelo_lunar.tres:39
msgid "Pasas rozando una luna. Los cráteres guardan secretos."
msgstr "You skim past a moon. The craters hold secrets."

#: content/encounters/sonda_abandonada.tres:8
msgid "Acoplar y saquear"
msgstr "Dock and loot"

#: content/encounters/sonda_abandonada.tres:17
msgid "Te llevas piezas."
msgstr "You take parts."

#: content/encounters/sonda_abandonada.tres:18
msgid "Golpeaste la sonda."
msgstr "You hit the probe."

#: content/encounters/sonda_abandonada.tres:23
msgid "Arrancar paneles con el brazo"
msgstr "Rip off panels with the arm"

#: content/encounters/sonda_abandonada.tres:32
msgid "Batería y chatarra."
msgstr "Battery and scrap."

#: content/encounters/sonda_abandonada.tres:33
msgid "Un panel rayó las cámaras."
msgstr "A panel scratched the cameras."

#: content/encounters/sonda_abandonada.tres:42
msgid "Sonda abandonada"
msgstr "Abandoned probe"

#: content/encounters/sonda_abandonada.tres:43
msgid "Una sonda vieja de otra misión. Paneles intactos y una caja negra."
msgstr "An old probe from another mission. Intact panels and a black box."

#: content/malfunctions/apagon_motor.tres:8
msgid "Reencender ya"
msgstr "Relight now"

#: content/malfunctions/apagon_motor.tres:13
msgid "Ruge otra vez."
msgstr "Roars again."

#: content/malfunctions/apagon_motor.tres:14
msgid "Encendió a medias."
msgstr "Half-lit."

#: content/malfunctions/apagon_motor.tres:18
msgid "Purgar y reencender"
msgstr "Purge and relight"

#: content/malfunctions/apagon_motor.tres:26
msgid "Limpio y estable."
msgstr "Clean and stable."

#: content/malfunctions/apagon_motor.tres:27
msgid "Murió del todo."
msgstr "It died completely."

#: content/malfunctions/apagon_motor.tres:31
msgid "Darlo por perdido"
msgstr "Write it off"

#: content/malfunctions/apagon_motor.tres:35
msgid "Un motor menos."
msgstr "One engine less."

#: content/malfunctions/apagon_motor.tres:40
msgid "Apagón de motor"
msgstr "Engine flameout"

#: content/malfunctions/apagon_motor.tres:41
msgid "%part% se apagó en pleno encendido."
msgstr "%part% shut down mid-burn."

#: content/malfunctions/cortocircuito.tres:8
msgid "Reiniciar sistema"
msgstr "Reboot system"

#: content/malfunctions/cortocircuito.tres:14
msgid "Frito."
msgstr "Fried."

#: content/malfunctions/cortocircuito.tres:18
msgid "Desviar energía"
msgstr "Reroute power"

#: content/malfunctions/cortocircuito.tres:22
msgid "Funciona, pero chupa batería."
msgstr "It works, but drains the battery."

#: content/malfunctions/cortocircuito.tres:26
msgid "Aislar la pieza"
msgstr "Isolate the part"

#: content/malfunctions/cortocircuito.tres:30
msgid "Desconectada para siempre."
msgstr "Disconnected for good."

#: content/malfunctions/cortocircuito.tres:35
msgid "Cortocircuito"
msgstr "Short circuit"

#: content/malfunctions/cortocircuito.tres:36
msgid "Chispas en %part%. Huele a quemado."
msgstr "Sparks in %part%. Smells like burning."

#: content/malfunctions/desacople_trabado.tres:8
msgid "Pernos de respaldo"
msgstr "Backup bolts"

#: content/malfunctions/desacople_trabado.tres:13
msgid "La etapa se solto."
msgstr "The stage came loose."

#: content/malfunctions/desacople_trabado.tres:14
msgid "Siguen trabados."
msgstr "Still stuck."

#: content/malfunctions/desacople_trabado.tres:18
msgid "Sacudir con los motores"
msgstr "Shake it loose with the engines"

#: content/malfunctions/desacople_trabado.tres:23
msgid "Se solto de un tiron."
msgstr "It came loose with one jerk."

#: content/malfunctions/desacople_trabado.tres:24
msgid "Algo más se rompió."
msgstr "Something else broke."

#: content/malfunctions/desacople_trabado.tres:29
msgid "Desacoplador trabado"
msgstr "Stuck decoupler"

#: content/malfunctions/desacople_trabado.tres:30
msgid "%part% no suelta la etapa. Peso muerto colgando."
msgstr "%part% will not release the stage. Dead weight hanging on."

#: content/malfunctions/error_navegacion.tres:8
msgid "Recalibrar"
msgstr "Recalibrate"

#: content/malfunctions/error_navegacion.tres:13
msgid "Cálculos limpios."
msgstr "Clean calculations."

#: content/malfunctions/error_navegacion.tres:14
msgid "La predicción quedó corta."
msgstr "The prediction fell short."

#: content/malfunctions/error_navegacion.tres:18
msgid "Navegar a ojo"
msgstr "Navigate by eye"

#: content/malfunctions/error_navegacion.tres:26
msgid "Error de navegación"
msgstr "Navigation error"

#: content/malfunctions/error_navegacion.tres:27
msgid "%part% calcula trayectorias imposibles."
msgstr "%part% is calculating impossible trajectories."

#: content/malfunctions/falla_misteriosa.tres:8
msgid "Ignorarlo"
msgstr "Ignore it"

#: content/malfunctions/falla_misteriosa.tres:13
msgid "Era nada."
msgstr "It was nothing."

#: content/malfunctions/falla_misteriosa.tres:14
msgid "Era algo."
msgstr "It was something."

#: content/malfunctions/falla_misteriosa.tres:18
msgid "Revisar a fondo"
msgstr "Inspect thoroughly"

#: content/malfunctions/falla_misteriosa.tres:25
msgid "Ajustado."
msgstr "Adjusted."

#: content/malfunctions/falla_misteriosa.tres:30
msgid "Falla misteriosa"
msgstr "Mysterious fault"

#: content/malfunctions/falla_misteriosa.tres:31
msgid "Algo en %part% hace un ruido que no debería."
msgstr "Something in %part% is making a noise it shouldn't."

#: content/malfunctions/fuga_cabina.tres:8
msgid "Parchar con kit"
msgstr "Patch with a kit"

#: content/malfunctions/fuga_cabina.tres:12
msgid "Hermetica otra vez."
msgstr "Airtight again."

#: content/malfunctions/fuga_cabina.tres:16
msgid "Cinta adhesiva"
msgstr "Duct tape"

#: content/malfunctions/fuga_cabina.tres:22
msgid "La cinta aguanta."
msgstr "The tape holds."

#: content/malfunctions/fuga_cabina.tres:23
msgid "Visores empanados y radio muda."
msgstr "Fogged visors and a silent radio."

#: content/malfunctions/fuga_cabina.tres:28
msgid "Fuga de aire en cabina"
msgstr "Cabin air leak"

#: content/malfunctions/fuga_cabina.tres:29
msgid "Silbido en %part%. La tripulación se pone el casco."
msgstr "Hissing in %part%. The crew puts on their helmets."

#: content/malfunctions/fuga_combustible.tres:8
msgid "Sellar con kit"
msgstr "Seal with a kit"

#: content/malfunctions/fuga_combustible.tres:15
msgid "Sellado."
msgstr "Sealed."

#: content/malfunctions/fuga_combustible.tres:19
msgid "Soldadura improvisada"
msgstr "Improvised weld"

#: content/malfunctions/fuga_combustible.tres:27
msgid "Aguanta la soldadura."
msgstr "The weld holds."

#: content/malfunctions/fuga_combustible.tres:28
msgid "La grieta se abrió más."
msgstr "The crack opened wider."

#: content/malfunctions/fuga_combustible.tres:32
msgid "Dejar que se vacíe"
msgstr "Let it drain"

#: content/malfunctions/fuga_combustible.tres:40
msgid "Fuga de combustible"
msgstr "Fuel leak"

#: content/malfunctions/fuga_combustible.tres:41
msgid "%part% pierde propelente. Cada segundo cuenta."
msgstr "%part% is losing propellant. Every second counts."

#: content/malfunctions/grieta_escudo.tres:8
msgid "Girar para repartir el calor"
msgstr "Rotate to spread the heat"

#: content/malfunctions/grieta_escudo.tres:16
msgid "El calor se reparte."
msgstr "The heat spreads out."

#: content/malfunctions/grieta_escudo.tres:17
msgid "La grieta se abrió."
msgstr "The crack opened."

#: content/malfunctions/grieta_escudo.tres:21
msgid "Rezar"
msgstr "Pray"

#: content/malfunctions/grieta_escudo.tres:26
msgid "Increíble, aguantó."
msgstr "Incredible, it held."

#: content/malfunctions/grieta_escudo.tres:27
msgid "El escudo se desprende."
msgstr "The shield tears away."

#: content/malfunctions/grieta_escudo.tres:32
msgid "Grieta en el escudo"
msgstr "Shield crack"

#: content/malfunctions/grieta_escudo.tres:33
msgid "%part% se agrieta en el peor momento."
msgstr "%part% cracks at the worst moment."

#: content/malfunctions/motor_desbalanceado.tres:8
msgid "Cortar potencia"
msgstr "Cut power"

#: content/malfunctions/motor_desbalanceado.tres:12
msgid "Vibra menos, empuja menos."
msgstr "Vibrates less, pushes less."

#: content/malfunctions/motor_desbalanceado.tres:16
msgid "Forzarlo a tope"
msgstr "Push it to the limit"

#: content/malfunctions/motor_desbalanceado.tres:24
msgid "Aguantó. De milagro."
msgstr "It held. By a miracle."

#: content/malfunctions/motor_desbalanceado.tres:25
msgid "El motor se desintegró."
msgstr "The engine disintegrated."

#: content/malfunctions/motor_desbalanceado.tres:29
msgid "Reiniciar ignición"
msgstr "Restart ignition"

#: content/malfunctions/motor_desbalanceado.tres:34
msgid "Volvió a la normalidad."
msgstr "Back to normal."

#: content/malfunctions/motor_desbalanceado.tres:35
msgid "No volvió a encender."
msgstr "It did not relight."

#: content/malfunctions/motor_desbalanceado.tres:40
msgid "Motor desbalanceado"
msgstr "Unbalanced engine"

#: content/malfunctions/motor_desbalanceado.tres:41
msgid "%part% vibra fuera de rango. Las alarmas no se callan."
msgstr "%part% vibrates out of range. The alarms will not stop."

#: content/malfunctions/panel_danado.tres:8
msgid "Recalibrar el mecanismo"
msgstr "Recalibrate the mechanism"

#: content/malfunctions/panel_danado.tres:13
msgid "Vuelve a su sitio."
msgstr "It snaps back into place."

#: content/malfunctions/panel_danado.tres:14
msgid "Se partió."
msgstr "It snapped."

#: content/malfunctions/panel_danado.tres:18
msgid "Replegarlo"
msgstr "Fold it back"

#: content/malfunctions/panel_danado.tres:26
msgid "Panel dañado"
msgstr "Damaged panel"

#: content/malfunctions/panel_danado.tres:27
msgid "%part% se dobla y pierde rendimiento."
msgstr "%part% bends and loses performance."

#: content/malfunctions/paracaidas_enredado.tres:8
msgid "Cortar y desplegar reserva"
msgstr "Cut away and deploy the reserve"

#: content/malfunctions/paracaidas_enredado.tres:13
msgid "La reserva se abrió."
msgstr "The reserve opened."

#: content/malfunctions/paracaidas_enredado.tres:14
msgid "No hay reserva que valga."
msgstr "No reserve can save this."

#: content/malfunctions/paracaidas_enredado.tres:18
msgid "Sacudir las cuerdas"
msgstr "Shake the lines"

#: content/malfunctions/paracaidas_enredado.tres:23
msgid "Se desenredó."
msgstr "It untangled."

#: content/malfunctions/paracaidas_enredado.tres:24
msgid "Se hizo jirones."
msgstr "It shredded."

#: content/malfunctions/paracaidas_enredado.tres:29
msgid "Paracaídas enredado"
msgstr "Tangled parachute"

#: content/malfunctions/paracaidas_enredado.tres:30
msgid "Las cuerdas de %part% se enredaron."
msgstr "The lines of %part% tangled."

#: content/malfunctions/pata_atascada.tres:8
msgid "Forzar el pistón"
msgstr "Force the piston"

#: content/malfunctions/pata_atascada.tres:13
msgid "Clack. Desplegada."
msgstr "Clack. Deployed."

#: content/malfunctions/pata_atascada.tres:14
msgid "Se dobló."
msgstr "It bent."

#: content/malfunctions/pata_atascada.tres:18
msgid "Dejarla así"
msgstr "Leave it as is"

#: content/malfunctions/pata_atascada.tres:26
msgid "Pata atascada"
msgstr "Stuck leg"

#: content/malfunctions/pata_atascada.tres:27
msgid "%part% no termina de desplegarse."
msgstr "%part% will not fully deploy."

#: content/malfunctions/sobrepresion.tres:8
msgid "Ventilar"
msgstr "Vent"

#: content/malfunctions/sobrepresion.tres:12
msgid "Presión normal, menos combustible."
msgstr "Normal pressure, less fuel."

#: content/malfunctions/sobrepresion.tres:21
msgid "Se estabilizó solo."
msgstr "It stabilized on its own."

#: content/malfunctions/sobrepresion.tres:22
msgid "El tanque reventó."
msgstr "The tank burst."

#: content/malfunctions/sobrepresion.tres:27
msgid "Sobrepresión en tanque"
msgstr "Tank overpressure"

#: content/malfunctions/sobrepresion.tres:28
msgid "La presión de %part% sube sin control."
msgstr "The pressure in %part% is rising out of control."

#: content/parts/aislante.tres:8
msgid "Manta MLI"
msgstr "MLI blanket"

#: content/parts/aislante.tres:9
msgid "Aislante de Kapton, la manta dorada. Guarda el calor de la nave lejos del Sol."
msgstr "Kapton insulation, the golden blanket. It keeps the ship's heat in far from the Sun."

#: content/parts/antena.tres:8
msgid "Antena HGA"
msgstr "HGA antenna"

#: content/parts/antena.tres:9
msgid "Antena de alta ganancia. Habla con la Red del Espacio Profundo."
msgstr "High-gain antenna. It talks to the Deep Space Network."

#: content/parts/bateria.tres:8
msgid "Batería Li-Ion"
msgstr "Li-Ion battery"

#: content/parts/bateria.tres:9
msgid "Batería de litio-ion. Guarda energía para la sombra y los picos."
msgstr "Lithium-ion battery. Stores energy for the shadow and for peaks."

#: content/parts/blindaje.tres:9
msgid "Como la bóveda de Juno. Protege la electrónica de llamaradas y cinturones."
msgstr "Like Juno's vault. Protects the electronics from flares and belts."

#: content/parts/capsula.tres:8
msgid "Cápsula Apolo"
msgstr "Apollo capsule"

#: content/parts/capsula.tres:9
msgid "Cápsula de morro romo. La tripulación va aquí. Sin ella no hay misión."
msgstr "Blunt-nosed capsule. The crew rides here. Without it there is no mission."

#: content/parts/computadora.tres:8
msgid "Computadora RAD750"
msgstr "RAD750 computer"

#: content/parts/computadora.tres:9
msgid "Computadora de vuelo endurecida, como la de Curiosity. Predice la trayectoria completa."
msgstr "Radiation-hardened flight computer, like Curiosity's. It predicts the full trajectory."

#: content/parts/desacoplador.tres:8
msgid "Pernos de etapa"
msgstr "Stage bolts"

#: content/parts/desacoplador.tres:9
msgid "Pernos frangibles: separan la etapa de abajo y se van con ella."
msgstr "Frangible bolts: they separate the stage below and go with it."

#: content/parts/escudo_ligero.tres:8
msgid "Escudo SLA-561"
msgstr "SLA-561 shield"

#: content/parts/escudo_ligero.tres:9
msgid "Ablativo ligero de las Viking. Sirve para una entrada suave, como la de Marte."
msgstr "Light ablative from the Vikings. Good for a gentle entry, like Mars."

#: content/parts/escudo_termico.tres:8
msgid "Escudo PICA"
msgstr "PICA shield"

#: content/parts/escudo_termico.tres:9
msgid "Ablativo de carbono, como el de Curiosity. Se consume en la entrada."
msgstr "Carbon ablative, like Curiosity's. It burns away on entry."

#: content/parts/giroscopio.tres:8
msgid "Rueda de reacción"
msgstr "Reaction wheel"

#: content/parts/giroscopio.tres:9
msgid "Gira la nave sin gastar propelente, como las ruedas del Hubble."
msgstr "Turns the ship without spending propellant, like Hubble's wheels."

#: content/parts/motor_chispa.tres:8
msgid "Motor AJ10"
msgstr "AJ10 engine"

#: content/parts/motor_chispa.tres:9
msgid "Propelentes almacenables, como el SPS del Apolo. No levanta una nave pesada desde el suelo."
msgstr "Storable propellants, like the Apollo SPS. It cannot lift a heavy ship off the ground."

#: content/parts/motor_susurro.tres:8
msgid "Motor RL10"
msgstr "RL10 engine"

#: content/parts/motor_susurro.tres:9
msgid "Motor de vacío, como el RL10 del Centauro. Casi no empuja, pero estira cada gota."
msgstr "Vacuum engine, like the Centaur's RL10. It barely pushes, but stretches every drop."

#: content/parts/motor_trueno.tres:8
msgid "Motor H-1"
msgstr "H-1 engine"

#: content/parts/motor_trueno.tres:9
msgid "Primera etapa, como el H-1 del Saturno I. Mucho empuje y mucho consumo."
msgstr "First stage, like the Saturn I's H-1. Lots of thrust and lots of consumption."

#: content/parts/panel_solar.tres:8
msgid "Panel triple unión"
msgstr "Triple-junction panel"

#: content/parts/panel_solar.tres:9
msgid "Celdas GaInP/GaAs/Ge. Rinden cerca del Sol, casi nada lejos, y se queman muy cerca."
msgstr "GaInP/GaAs/Ge cells. They perform near the Sun, almost nothing far away, and burn out very close."

#: content/parts/paracaidas.tres:8
msgid "Paracaídas DGB"
msgstr "DGB parachute"

#: content/parts/paracaidas.tres:9
msgid "Disco y banda, como el de Perseverance. Freno (P) y principal (P otra vez)."
msgstr "Disk-gap-band, like Perseverance's. Drogue (P) and main (P again)."

#: content/parts/patas.tres:8
msgid "Patas de panal"
msgstr "Honeycomb legs"

#: content/parts/patas.tres:9
msgid "Panal de aluminio que se aplasta, como en el módulo lunar. Aguanta un golpe más duro."
msgstr "Crushable aluminum honeycomb, like on the lunar module. Takes a harder hit."

#: content/parts/radiador.tres:8
msgid "Radiador de amoníaco"
msgstr "Ammonia radiator"

#: content/parts/radiador.tres:9
msgid "Como los paneles de la estación. Tira el calor cerca del Sol."
msgstr "Like the station's panels. Dumps heat near the Sun."

#: content/parts/rcs.tres:8
msgid "Propulsores RCS"
msgstr "RCS thrusters"

#: content/parts/rcs.tres:9
msgid "Motores pequeños de actitud, como los del Apolo. Giran la nave gastando propelente."
msgstr "Small attitude engines, like the Apollo's. They turn the ship while spending propellant."

#: content/parts/rtg.tres:9
msgid "Generador de plutonio-238, como el de Curiosity. Da energía en cualquier sitio y también calienta."
msgstr "Plutonium-238 generator, like Curiosity's. It gives power anywhere and also heats."

#: content/parts/sensores.tres:8
msgid "Seguidor estelar"
msgstr "Star tracker"

#: content/parts/sensores.tres:9
msgid "Orientación por estrellas. Avisa de llamaradas y marca lo que hay alrededor."
msgstr "Star-based orientation. It warns of flares and marks what is around you."

#: content/parts/tanque_ancho.tres:8
msgid "Núcleo ancho"
msgstr "Wide core"

#: content/parts/tanque_ancho.tres:9
msgid "Tanque ancho de aluminio-litio. 16 t de propelente. Pesa, pero rinde."
msgstr "Wide aluminum-lithium tank. 16 t of propellant. Heavy, but worth it."

#: content/parts/tanque_corto.tres:8
msgid "Tanque Al-Li corto"
msgstr "Short Al-Li tank"

#: content/parts/tanque_corto.tres:9
msgid "Tanque de aluminio-litio. 4 t de propelente."
msgstr "Aluminum-lithium tank. 4 t of propellant."

#: content/parts/tanque_gota.tres:8
msgid "Tanque Atlas"
msgstr "Atlas tank"

#: content/parts/tanque_gota.tres:9
msgid "Tanque globo, como el del Atlas: barato y frágil. 6 t si no se raja."
msgstr "Balloon tank, like the Atlas's: cheap and fragile. 6 t if it does not crack."

#: content/parts/tanque_largo.tres:8
msgid "Tanque Al-Li largo"
msgstr "Long Al-Li tank"

#: content/parts/tanque_largo.tres:9
msgid "Tanque de aluminio-litio. 9 t de propelente."
msgstr "Aluminum-lithium tank. 9 t of propellant."

#: content/parts/torre_escape.tres:8
msgid "Torre LES"
msgstr "LES tower"

#: content/parts/torre_escape.tres:9
msgid "Torre de escape de tracción, como la del Apolo. Aborta el despegue y salva la cápsula (Retroceso)."
msgstr "Pulling escape tower, like the Apollo's. It aborts the launch and saves the capsule (Backspace)."

#: data/design/training.json:1
msgid "Abre el freno del paracaídas"
msgstr "Open the parachute drogue"

#: data/design/training.json:1
msgid "Abre el paracaídas principal"
msgstr "Open the main parachute"

#: data/design/training.json:1
msgid "Activa Ignición cuando el reloj marque cero. La práctica espera en T-0: una pulsación temprana explica el error sin consumir combustible."
msgstr "Activate Ignition when the clock reaches zero. The practice waits at T-0: an early press explains the mistake without using fuel."

#: data/design/training.json:1
msgid "Ahora sí: separa la primera etapa"
msgstr "Now it's time: separate the first stage"

#: data/design/training.json:1
msgid "Ajusta el ángulo dentro de la franja verde y activa Entrar. Muy plano puede hacerte salir de la atmósfera; demasiado empinado concentra calor y carga. El tramo de costa se resume [DIS]."
msgstr "Adjust the angle inside the green band and activate Enter. Too flat can send you back out of the atmosphere; too steep concentrates heat and load. The coasting stretch is summarized [DIS]."

#: data/design/training.json:1
msgid "Ajusta potencia y orientación. La asistencia sigue el corredor cuando sueltas el giro. Vigila presión y combustible de la etapa activa."
msgstr "Adjust power and orientation. The assist follows the corridor when you release the turn. Watch pressure and the active stage's fuel."

#: data/design/training.json:1
msgid "Aprende a orientar"
msgstr "Learn to steer"

#: data/design/training.json:1
msgid "Apunta contra el movimiento"
msgstr "Aim against the motion"

#: data/design/training.json:1
msgid "Avería programada de práctica. El cierre no se liberó. Usa Reparar; después vuelve a activar Separar. El vuelo permanece congelado."
msgstr "Scripted practice malfunction. The latch did not release. Use Repair; then activate Separate again. The flight stays frozen."

#: data/design/training.json:1
msgid "Cabina de mando"
msgstr "Command cabin"

#: data/design/training.json:1
msgid "Colócalo sobre el H-1. Cada motor consume solo los tanques de su etapa."
msgstr "Place it on top of the H-1. Each engine only burns the tanks of its own stage."

#: data/design/training.json:1
msgid "Comprueba la nueva etapa"
msgstr "Check the new stage"

#: data/design/training.json:1
msgid "Construiste dos etapas, redujiste la carga del aire, reparaste el cierre, separaste sin desperdiciar combustible y regresaste con escudo y paracaídas. Puedes volver al hangar o repetir."
msgstr "You built two stages, reduced the air load, repaired the latch, separated without wasting fuel and returned with a shield and a parachute. You can go back to the hangar or repeat."

#: data/design/training.json:1
msgid "Construye de abajo hacia arriba"
msgstr "Build from the bottom up"

#: data/design/training.json:1
msgid "Deja trabajar al escudo"
msgstr "Let the shield work"

#: data/design/training.json:1
msgid "Desacoplador atascado"
msgstr "Stuck decoupler"

#: data/design/training.json:1
msgid "El RL10 va encima de los pernos de etapa. Es eficiente en el vacío; solo no levanta esta nave desde el suelo."
msgstr "The RL10 goes above the stage bolts. It is efficient in vacuum; on its own it cannot lift this ship off the ground."

#: data/design/training.json:1
msgid "El aire frena la nave y calienta el escudo. Observa su reserva. Espera la ventana segura antes de desplegar el freno del paracaídas."
msgstr "The air slows the ship and heats the shield. Watch its reserve. Wait for the safe window before deploying the parachute drogue."

#: data/design/training.json:1
msgid "El cierre está reparado. Activa Separar una sola vez para descartar el motor y tanque vacíos de abajo."
msgstr "The latch is repaired. Activate Separate once to discard the empty engine and tank below."

#: data/design/training.json:1
msgid "El escudo protege la cabina durante la entrada. Añade masa, pero su material absorbe calor al consumirse."
msgstr "The shield protects the cabin during entry. It adds mass, but its material absorbs heat as it burns away."

#: data/design/training.json:1
msgid "El motor va abajo. El H-1 levanta el peso del cohete, pero consume más combustible."
msgstr "The engine goes at the bottom. The H-1 lifts the rocket's weight, but burns more fuel."

#: data/design/training.json:1
msgid "Elige el corredor de entrada"
msgstr "Choose the entry corridor"

#: data/design/training.json:1
msgid "Este tanque alimenta el RL10. El combustible de abajo no sirve después de separar."
msgstr "This tank feeds the RL10. The fuel below is useless after separation."

#: data/design/training.json:1
msgid "Frena para regresar"
msgstr "Brake to return"

#: data/design/training.json:1
msgid "Freno para aterrizar"
msgstr "Brake for landing"

#: data/design/training.json:1
msgid "Generación eléctrica"
msgstr "Power generation"

#: data/design/training.json:1
msgid "Gira hasta el objetivo retrógrado de -90 grados [DIS]. Apuntar a favor del movimiento aceleraría la nave."
msgstr "Turn to the retrograde target of -90 degrees [DIS]. Aiming with the motion would speed the ship up."

#: data/design/training.json:1
msgid "Ignición en T-0"
msgstr "Ignition at T-0"

#: data/design/training.json:1
msgid "La batería guarda energía. No la genera: necesita el panel para recargarse."
msgstr "The battery stores energy. It does not generate it: it needs the panel to recharge."

#: data/design/training.json:1
msgid "La cabina debe quedar en la etapa que conservas. No la pongas debajo de los pernos de etapa."
msgstr "The cabin must stay in the stage you keep. Do not put it below the stage bolts."

#: data/design/training.json:1
msgid "La masa descartada ya no pesa. Sube la potencia hasta 100 % [DIS] para comprobar que el RL10 produce empuje con su propio tanque."
msgstr "The discarded mass no longer weighs you down. Raise the power to 100 % [DIS] to check that the RL10 produces thrust from its own tank."

#: data/design/training.json:1
msgid "La presión actual está por debajo del límite de carga. Vuelve a subir la potencia al 100 % [DIS] para sostener el ascenso. Reducirla durante demasiado tiempo desperdicia combustible luchando contra la gravedad."
msgstr "The current pressure is below the load limit. Raise the power back to 100 % [DIS] to sustain the climb. Keeping it reduced for too long wastes fuel fighting gravity."

#: data/design/training.json:1
msgid "Llegaste a órbita. La velocidad horizontal sostiene el vuelo. Inicia Regreso para aprender a frenar en sentido contrario al movimiento."
msgstr "You reached orbit. Horizontal speed sustains the flight. Start Return to learn to brake against the direction of motion."

#: data/design/training.json:1
msgid "Los paneles mantienen la electrónica encendida con luz solar. Añaden masa y no generan en la sombra."
msgstr "The panels keep the electronics running on sunlight. They add mass and generate nothing in shadow."

#: data/design/training.json:1
msgid "Límite entre etapas"
msgstr "Stage boundary"

#: data/design/training.json:1
msgid "Motor de primera etapa"
msgstr "First-stage engine"

#: data/design/training.json:1
msgid "Motor de segunda etapa"
msgstr "Second-stage engine"

#: data/design/training.json:1
msgid "Protección para regresar"
msgstr "Protection for the return"

#: data/design/training.json:1
msgid "Práctica completada"
msgstr "Practice completed"

#: data/design/training.json:1
msgid "Recupera potencia para subir"
msgstr "Restore power to climb"

#: data/design/training.json:1
msgid "Reduce la carga del aire"
msgstr "Reduce the air load"

#: data/design/training.json:1
msgid "Reintenta la separación"
msgstr "Retry the separation"

#: data/design/training.json:1
msgid "Reserva eléctrica"
msgstr "Power reserve"

#: data/design/training.json:1
msgid "Revisa y reintenta"
msgstr "Review and retry"

#: data/design/training.json:1
msgid "Selecciona la pieza resaltada. La posición se numera desde la base. Puedes retirar o mover piezas; la guía vuelve al primer requisito pendiente."
msgstr "Select the highlighted part. Positions are numbered from the base. You can remove or move parts; the guide goes back to the first pending requirement."

#: data/design/training.json:1
msgid "Sigue el corredor"
msgstr "Follow the corridor"

#: data/design/training.json:1
msgid "Sube la potencia. El encendido retrógrado reduce la velocidad orbital y consume la reserva de la etapa superior."
msgstr "Raise the power. The retrograde burn reduces orbital speed and uses the upper stage's reserve."

#: data/design/training.json:1
msgid "Tanque de primera etapa"
msgstr "First-stage tank"

#: data/design/training.json:1
msgid "Tanque de segunda etapa"
msgstr "Second-stage tank"

#: data/design/training.json:1
msgid "Usa Reintentar para recuperar el último punto de control. La práctica no cambia créditos, contratos ni inventario."
msgstr "Use Retry to restore the last checkpoint. The practice does not change credits, contracts or inventory."

#: data/design/training.json:1
msgid "Va sobre el primer tanque. Al activarlo se descarta todo lo que queda debajo, incluidos los pernos de etapa."
msgstr "It goes on top of the first tank. When activated, everything below is discarded, including the stage bolts."

#: data/design/training.json:1
msgid "Va sobre la cabina. Se abre en dos pasos y solo cuando la velocidad permite hacerlo."
msgstr "It goes on top of the cabin. It opens in two steps and only when the speed allows it."

#: data/design/training.json:1
msgid "Vuelo congelado en una ventana segura. Activa Paracaídas para desplegar el freno pequeño. El principal todavía requiere menos velocidad y altura."
msgstr "Frozen flight in a safe window. Activate Parachute to deploy the small drogue. The main still needs lower speed and altitude."

#: data/design/training.json:1
msgid "Vuelo congelado. Activa Paracaídas otra vez: el principal aumenta el área y reduce la velocidad de caída."
msgstr "Frozen flight. Activate Parachute again: the main increases the area and reduces the fall speed."

#: data/design/training.json:1
