; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NasaSpaceGame"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
Events="*res://game/autoload/events.gd"
Catalog="*res://game/autoload/catalog.gd"
Profile="*res://game/autoload/profile.gd"
Settings="*res://game/autoload/settings.gd"
Run="*res://game/autoload/run.gd"
Synth="*res://game/autoload/synth.gd"
Music="*res://game/autoload/music.gd"
Juice="*res://game/autoload/juice.gd"
Router="*res://game/autoload/router.gd"
Pause="*res://game/autoload/pause.gd"
Controls="*res://game/autoload/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode="fullscreen"
window/size/borderless=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

